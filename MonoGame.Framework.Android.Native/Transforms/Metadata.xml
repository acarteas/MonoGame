<metadata>
  <!-- Keep the SDL API under its Java namespace; this is distinct from the
       framework's Microsoft.Xna.Framework types. JNI names remain unchanged. -->
  <attr path="/api/package[@name='org.libsdl.app']" name="managedName">Org.Libsdl.App</attr>
  <!-- Retain Java-style override methods for the host's entrypoint selection. -->
  <attr path="/api/package[@name='org.libsdl.app']/class[@name='SDLActivity']/method[@name='getMainFunction' or @name='getMainSharedObject']" name="propertyName"></attr>
  <!-- These protected implementation details use package-private Java types.
       Omit only their managed wrappers; every original class remains in the jar. -->
  <remove-node path="/api/package[@name='org.libsdl.app']/class[@name='SDLActivity']/field[@name='mClipboardHandler' or @name='mMotionListener' or @name='mTextEdit']" />
  <remove-node path="/api/package[@name='org.libsdl.app']/class[@name='SDLActivity']/method[@name='getMotionListener']" />
  <remove-node path="/api/package[@name='org.libsdl.app']/class[@name='SDLControllerManager']/field[@name='mHapticHandler' or @name='mJoystickHandler']" />
</metadata>
